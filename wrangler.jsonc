{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-reset",
  "compatibility_date": "2026-10-14",
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "the-reset-check",
      "database_id": "d745d0c7-c332-4c08-be9b-451ec7fe1a62",
      // Local `wrangler pages dev` uses this preview id, not the production database.
      "preview_database_id": "DB",
      "migrations_dir": "migrations",
    },
  ],
  // 30-day reset list signups (functions/api/reset-signup.ts). Free-tier KV namespace "calltoreset-reset-signups".
  "kv_namespaces": [
    {
      "binding": "SIGNUPS",
      "id": "ee5a1a62bcef45f99af6871cacae1098",
    },
  ],
}
