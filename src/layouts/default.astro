---
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/ancizar-serif/400.css";
import "@fontsource/ancizar-serif/500.css";
import "@fontsource/azeret-mono/400.css";
import "@fontsource/azeret-mono/500.css";
import "lenis/dist/lenis.css";
import "@styles/global.css";
import "@styles/course.css";
import "@styles/aureum.css";
import { ClientRouter } from 'astro:transitions';
import Footer from "@components/layout/footer.astro";
import TopBanner from "@components/promo/top-banner.astro";
import NewsletterSignup from "@components/promo/newsletter-signup-wrapper.astro";
import FooterBanner from "@components/promo/footer-banner.astro";
import Header from "@components/layout/header.astro";
import Hero from "@components/layout/hero.astro";
import HeadBase from "@components/head/base.astro";
import HeadHrefLang from "@components/head/hreflang.astro";
import HeadOgX from "@components/head/ogx.astro";
import WebsiteStructuredData from "@components/structured/website.astro";
import WebPageStructuredData from "@components/structured/webpage.astro";
import LanguageSelect from "@components/layout/language-select.astro";
import WebMCPTools from "@components/webmcp-tools.astro";
import SponsorFrame from "@components/sponsors/SponsorFrame.astro";
import JoinNewsletter from "@components/promo/JoinNewsletter.astro";
import { useTranslations } from "@utils/i18n";
import { themeConfig } from '~/theme.config';
import { SPONSORS_ENABLED } from '@data/site';
import { snippet, absoluteUrl } from '@utils/seo';
import type { CollectionKey } from "astro:content";

interface Props {
  title?: string;
  description?: string;
  header?: {
    /** Hides the header */
    hidden?: boolean;
    /** Makes the header stick to the top of the page */
    fixed?: boolean;
    /** Puts the header above the content (overlay) */
    overlay?: boolean;
    /** Pixels scrolled before showing scroll header (default: header out of viewport) */
    scrollDownThreshold?: number;
    /** Show a close icon instead of the site name or button */
    closeIcon?: boolean;
    /** Show a button instead of the site name. (For example, "Back to articles" when used in an article page header.) */
    button?: {
      text: string;
      href: string;
    };
    /** Force hide or show the top banner */
    showTopBanner?: boolean;
  };
  showFooterBanner?: boolean; // Force hide or show the footer banner
  robots?: string;
  isError?: boolean;
  locale?: string;
  noi18n?: boolean;
  isHome?: boolean;
  noTitleSlug?: boolean; // if true, the title slug (e.g. " | Stardrive") will not be added to the title
  schemaType?: 'WebPage' | 'FAQPage';
  collection?: CollectionKey; // we need this (for things like events or integration_options) to identify whether pages are translated or not
  contentId?: string; // we need this (for things like events or integration_options) to identify whether pages are translated or not
  noContainer?: boolean; // if true, the content will not be wrapped in a container div (useful for full-width pages like the homepage)
  showHero?: boolean;
  /** Public path of this page's cover, used as its share image (og:image / twitter:image). */
  image?: { src: string; alt?: string; width?: number; height?: number };
  ogType?: 'website' | 'article';
}

const locale = Astro.props.locale || themeConfig.i18n.defaultLocale;
const t = useTranslations(locale);

const title = Astro.props.title || t('meta.title');
const description = snippet(Astro.props.description || t('meta.description'));
const { image, ogType } = Astro.props;
const { isError, noi18n, noTitleSlug, robots, isHome, schemaType, header, showFooterBanner, collection, contentId, noContainer, showHero } = Astro.props;
const renderHero = showHero ?? Boolean(isHome);

const ogTitle = themeConfig.ogTitle ?? themeConfig.name ?? t('meta.og-site-name');
const metaTitle = noTitleSlug ? title : `${title} | ${themeConfig.name}`;

const structuredDataImage = image?.src ?? '/images/structured-preview.png'; // inside the public dir; 16:9, min 1920x1080px recommended
const type = schemaType || 'WebPage';
const i18nStructured = themeConfig.i18n.translatedStructuredData ? themeConfig.i18n.translatedStructuredData[locale.toString()] : null;
const author = {
  '@type': themeConfig.author.type,
  name: locale !== themeConfig.i18n.defaultLocale && i18nStructured?.author?.name ? i18nStructured.author.name : themeConfig.author.name,
  url: locale !== themeConfig.i18n.defaultLocale && i18nStructured?.author?.url ? i18nStructured.author.url : themeConfig.author.url,
  image: themeConfig.author.image && themeConfig.author.image !== '' ? themeConfig.author.image : undefined,
};
const publisher = {
  '@type': themeConfig.publisher.type,
  name: locale !== themeConfig.i18n.defaultLocale && i18nStructured?.publisher?.name ? i18nStructured.publisher.name : themeConfig.publisher.name,
  url: locale !== themeConfig.i18n.defaultLocale && i18nStructured?.publisher?.url ? i18nStructured.publisher.url : themeConfig.publisher.url,
  image: themeConfig.publisher.image && themeConfig.publisher.image !== '' ? themeConfig.publisher.image : undefined,
};

const showTopBanner = (themeConfig.promotions?.topBanner && header?.showTopBanner !== false) || header?.showTopBanner;
---

<!doctype html>
<html lang={locale}>
  <head>
    <HeadBase title={metaTitle} {description} {locale} {robots} {isError} />
    <HeadHrefLang {locale} {noi18n} {collection} {contentId} />
    <HeadOgX {locale} title={metaTitle} {description} {ogTitle} ogImage={image ? absoluteUrl(image.src) : undefined} xImage={image ? absoluteUrl(image.src) : undefined} imageAlt={image?.alt} imageWidth={image?.width} imageHeight={image?.height} type={ogType} />
    <!-- Structured Data -->
    {isHome ? <WebsiteStructuredData {title} image={structuredDataImage} {author} {publisher} {locale} /> : null}
    <WebPageStructuredData {type} {title} {description} image={structuredDataImage} {author} {publisher} {locale} />
    <!-- Transitions -->
    <ClientRouter />
  </head>
  <body class:list={{ "sponsors-on": SPONSORS_ENABLED }}>
    <div class="au-loader" data-loader>
      <span>{themeConfig.name}</span>
    </div>
    <script is:inline>
      try {
        if (sessionStorage.getItem('reset-loader') || matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.querySelector('[data-loader]')?.remove();
        }
      } catch {
        /* storage can be blocked */
      }
    </script>
    <SponsorFrame />
    {showTopBanner ? <TopBanner {locale} /> : null}
    <div class="relative w-full">
      {header?.hidden !== true && <Header {locale} button={header?.button ?? undefined} ctaButton={{ text: 'Start here', href: '/check' }} {isHome} fixed={header?.fixed} overlay={header?.overlay} overlayTheme="dark" scrollDownThreshold={header?.scrollDownThreshold} closeIcon={header?.closeIcon} hasTopBanner={showTopBanner} />}
      <main role="main" class="relative z-40">
        {renderHero && <Hero {locale} />}
        {!noContainer ? (
          <div class="container pt-4 pb-10 md:pt-8 md:pb-14 lg:pb-16">
            <slot />
          </div>
        ) : (
          <slot />
        )}
      </main>
      {(themeConfig.promotions?.footerBanner && showFooterBanner !== false) || showFooterBanner ? <FooterBanner {locale} /> : null}
      {themeConfig.promotions?.newsletterSignup === 'bottom' && <NewsletterSignup {locale} />}
      <section class="newsletter-band" aria-label="Newsletter">
        <div class="newsletter-band-inner">
          <JoinNewsletter />
        </div>
      </section>
      <Footer {locale} {isError} {isHome} />
    </div>
    <LanguageSelect {noi18n} {collection} {contentId} {locale} />
    <WebMCPTools {locale} />
    <script>
      import { mountMotion } from '@scripts/aureum-motion';

      mountMotion();
      document.addEventListener('astro:page-load', mountMotion);
    </script>
  </body>
</html>
