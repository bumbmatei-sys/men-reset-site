---
import Layout from '@layouts/default.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import { themeConfig } from '~/theme.config';
import { sponsorUrl, sponsors } from '@utils/sponsors';

const title = 'Sponsors';
const description = `Brands listed on ${themeConfig.name}. This directory is the listing for every sponsor tier.`;

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: themeConfig.site },
    { '@type': 'ListItem', position: 2, name: 'Sponsors', item: new URL('/sponsors', themeConfig.site).toString() },
  ],
};

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Sponsors',
  itemListElement: sponsors.map((sponsor, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: sponsor.name,
    url: new URL(sponsor.url, themeConfig.site).toString(),
  })),
};
---

<Layout title={title} description={description}>
  <JsonLd data={breadcrumbs} />
  <JsonLd data={itemList} />
  <nav aria-label="Breadcrumb" class="page-crumb">
    <a href="/">Home</a>
    <span aria-hidden="true"> / </span>
    <span>Sponsors</span>
  </nav>
  <p class="course-kicker">Directory</p>
  <h1 class="page-title">Sponsors</h1>
  <p class="page-lead">The Harvest sponsors this site. One spot is still open.</p>
  <p class="page-actions">
    <a class="btn-secondary" href="/sponsor">
      Sponsor
    </a>
  </p>
  <ul class="sponsor-directory">
    {sponsors.map((sponsor) => {
      const href = sponsorUrl(sponsor.url, 'directory');
      const external = href.startsWith('http');
      const open = sponsor.id.startsWith('placeholder');
      return (
        <li>
          <a class="sponsor-card" href={href} rel={external ? 'sponsored noopener' : 'sponsored'} target={external ? '_blank' : undefined}>
            {open ? <span class="au-stat-flag">Open spot</span> : null}
            {sponsor.logo ? <img class="sponsor-logo" src={sponsor.logo} alt="" width="480" height="796" /> : null}
            <span class="sponsor-name">{sponsor.name}</span>
            <span class="sponsor-tagline">{sponsor.tagline}</span>
            <span class="sponsor-cta">{sponsor.cta}</span>
          </a>
        </li>
      );
    })}
  </ul>
</Layout>
