---
import Layout from '@layouts/default.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import { themeConfig } from '~/theme.config';
import { getTeachings, toCard, formatDate, isBlogPreview, type TeachingCard } from '@utils/teachings';
import MarbleAccent from '@components/course/MarbleAccent.astro';
import FilterPills from '@components/course/FilterPills.astro';
import TopicRequest from '@components/course/TopicRequest.astro';
import '../../styles/teachings.css';

const preview = isBlogPreview();
let cards: TeachingCard[] = (await getTeachings()).map(toCard);
cards.sort((a, b) => b.date.getTime() - a.date.getTime());

const [featured, ...rest] = cards;
const highlights = rest.slice(0, 3);
const latest = rest.slice(3);
const categories = [...new Set(cards.map((c) => c.category))];

const title = 'Teachings: Faith, Freedom and Discipline';
const description = "Practical Christian teachings on God's love, identity in Christ, freedom and a life aimed at something. Written by Matei Bumb.";
const pageUrl = new URL('/teachings', themeConfig.site).toString();
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: themeConfig.site },
    { '@type': 'ListItem', position: 2, name: 'Teachings', item: pageUrl },
  ],
};
---

<Layout title={title} description={description}>
  <JsonLd data={breadcrumbs} />
  <div class="tch">
    <header class="tch-head">
      <p class="tch-kicker">{preview ? 'Teachings · preview' : 'Teachings'}</p>
      <div class="tch-head-row"><MarbleAccent kind="pillar" alt="" /><h1 class="tch-head-title">Teachings</h1></div>
      <FilterPills categories={categories} label="Filter teachings by topic" scope="teachings" />
    </header>

    <div data-filter-scope="teachings">
    {featured ? (
      <>
        <a class={`tch-feature${featured.image ? '' : ' tch-noimg'}`} href={featured.href} data-filter-item data-category={featured.category}>
          {featured.image ? <span class="tch-feature-media"><img src={featured.image.src} alt={featured.image.alt} width="1280" height="720" fetchpriority="high" decoding="async" /></span> : null}
          <span class="tch-feature-body">
            <span class="tch-feature-flag"><MarbleAccent kind="laurel" alt="" /><span class="tch-kicker">Latest · {featured.category}</span></span>
            <span class="tch-feature-title">{featured.title}</span>
            <span class="tch-excerpt">{featured.excerpt}</span>
            <span class="tch-meta"><time datetime={featured.date.toISOString()}>{formatDate(featured.date)}</time> · {featured.minutes} min read</span>
          </span>
        </a>

        {highlights.length > 0 ? (
          <ul class="tch-highlights" data-filter-group>
            {highlights.map((c) => (
              <li data-filter-item data-category={c.category}>
                <a class={`tch-overlay${c.image ? '' : ' tch-noimg'}`} href={c.href}>
                  {c.image ? <img src={c.image.src} alt={c.image.alt} width="640" height="640" decoding="async" /> : null}
                  <span class="tch-overlay-label">
                    <span class="tch-kicker">{c.category}</span>
                    <span class="tch-overlay-title">{c.title}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        ) : null}

        <div class="tch-split">
          <section aria-labelledby="latest-heading" data-filter-group>
            {latest.length > 0 ? (
              <>
                <h2 id="latest-heading" class="tch-section-label">Latest teachings</h2>
                <ul class="tch-list">
                  {latest.map((c) => (
                    <li data-filter-item data-category={c.category}>
                      <a class="tch-row" href={c.href}>
                        {c.image ? <span class="tch-row-media"><img src={c.image.src} alt={c.image.alt} width="480" height="360" decoding="async" /></span> : null}
                        <span class="tch-row-body">
                          <span class="tch-kicker">{c.category}</span>
                          <span class="tch-row-title">{c.title}</span>
                          <span class="tch-excerpt tch-clamp">{c.excerpt}</span>
                          <span class="tch-meta"><time datetime={c.date.toISOString()}>{formatDate(c.date)}</time> · {c.minutes} min read</span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            ) : <h2 id="latest-heading" class="sr-only">Latest teachings</h2>}
          </section>
          <aside class="tch-side">
            <div class="tch-card">
              <p class="tch-section-label">About the author</p>
              <div class="tch-author">
                <img src="/images/matei.webp" alt="Matei Bumb" width="64" height="64" loading="lazy" />
                <p class="tch-author-name">Matei Bumb</p>
              </div>
              <p class="tch-card-text">Founder of Call to Reset. He writes so that children of God know their identity, live in holiness and take initiative.</p>
              <a class="tch-textlink" href="/about">Read more</a>
            </div>
            <div class="tch-card">
              <p class="tch-section-label">Start here</p>
              <p class="tch-card-text">Answer a few honest questions and get a plan written from your answers. About three minutes.</p>
              <a class="tch-btn" href="/check">Take the free check</a>
            </div>
          </aside>
        </div>
      </>
    ) : (
      <div class="tch-card tch-empty">
        <p class="tch-section-label">First teachings coming soon</p>
        <p class="tch-card-text">Until then, take the <a href="/check">free check</a> or start the <a href="/tracks/30-day-reset">30-day reset</a>.</p>
      </div>
    )}
    <p class="filter-empty" data-filter-empty hidden>Nothing here yet in this topic.</p>
    </div>
    <TopicRequest source="teachings" />
  </div>
</Layout>
