---
import Layout from '@layouts/default.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import { render } from 'astro:content';
import { themeConfig } from '~/theme.config';
import { getTeachings, teachingPath, formatDate, type TeachingEntry } from '@utils/teachings';

export async function getStaticPaths() {
  const entries = await getTeachings();
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: TeachingEntry };
const { Content, headings } = await render(entry);
const d = entry.data;
const updated = d.updatedDate ?? d.publishDate;
const pageUrl = new URL(teachingPath(entry), themeConfig.site).toString();
const imageUrl = new URL(d.image.src, themeConfig.site).toString();
const bio = 'Matei Bumb is the founder of Call to Reset. He writes plain, scripture-grounded guidance for men leaving porn, gaming and drift behind for a disciplined life in Christ.';

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  image: imageUrl,
  url: pageUrl,
  mainEntityOfPage: pageUrl,
  inLanguage: 'en-US',
  datePublished: d.publishDate.toISOString(),
  dateModified: updated.toISOString(),
  author: { '@type': 'Person', name: d.author, url: new URL('/about', themeConfig.site).toString(), description: bio },
  publisher: { '@type': 'Organization', name: themeConfig.name, url: themeConfig.site },
};
const faqLd = d.faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    }
  : null;
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: themeConfig.site },
    { '@type': 'ListItem', position: 2, name: 'Teachings', item: new URL('/teachings', themeConfig.site).toString() },
    { '@type': 'ListItem', position: 3, name: d.title, item: pageUrl },
  ],
};
const toc = headings.filter((h) => h.depth === 2);
---

<Layout title={d.title} description={d.description} robots={d.draft ? 'noindex, nofollow' : undefined}>
  <JsonLd data={articleLd} />
  {faqLd ? <JsonLd data={faqLd} /> : null}
  <JsonLd data={breadcrumbs} />
  <article class="teaching-article">
    <nav aria-label="Breadcrumb" class="page-crumb">
      <a href="/">Home</a>
      <span aria-hidden="true"> / </span>
      <a href="/teachings">Teachings</a>
      <span aria-hidden="true"> / </span>
      <span>{d.title}</span>
    </nav>
    <p class="course-kicker">{d.draft ? 'Teachings · draft preview' : 'Teachings'}</p>
    <h1 class="lesson-title">{d.title}</h1>
    <p class="lesson-meta teaching-byline">
      <span>By <a href="/about">{d.author}</a></span>
      <span aria-hidden="true"> · </span>
      <span>Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></span>
      <span aria-hidden="true"> · </span>
      <span>{d.readingTime} min read</span>
    </p>

    {d.takeaways.length > 0 ? (
      <aside class="takeaway teaching-takeaways" aria-labelledby="takeaways-heading">
        <p class="course-kicker" id="takeaways-heading">Key takeaways</p>
        <ul>{d.takeaways.map((t) => <li>{t}</li>)}</ul>
      </aside>
    ) : null}

    <figure class="teaching-cover">
      <img src={d.image.src} alt={d.image.alt} width="1200" height="750" decoding="async" />
    </figure>

    {toc.length > 2 ? (
      <nav class="teaching-toc" aria-label="On this page">
        <p class="course-kicker">On this page</p>
        <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </nav>
    ) : null}

    <div class="lesson-prose mt-8">
      <Content />
    </div>

    {d.faq.length > 0 ? (
      <section class="teaching-faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="page-subhead">Frequently asked questions</h2>
        {d.faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>
    ) : null}

    <section class="action-callout teaching-cta" aria-labelledby="cta-heading">
      <p class="course-kicker">Start here</p>
      <h2 id="cta-heading">Take the free check</h2>
      <p>Answer a few honest questions and get a plan written from your answers. It takes about three minutes.</p>
      <a class="btn-primary" href="/check">Take the free check</a>
    </section>

    <aside class="teaching-author" aria-label="About the author">
      <img src="/logo/ctr-logo.png" alt="" width="56" height="56" loading="lazy" />
      <div>
        <p class="course-kicker">Written by</p>
        <p><strong>{d.author}</strong>. {bio}</p>
      </div>
    </aside>
  </article>
</Layout>
