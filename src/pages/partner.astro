---
import Layout from '@layouts/default.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import SponsorCancel from '@components/sponsors/SponsorCancel.astro';
import { themeConfig } from '~/theme.config';
import { SPONSORS_ENABLED } from '@data/site';

if (!SPONSORS_ENABLED) {
  return Astro.redirect('/');
}

const tiers = themeConfig.sponsorTiers;
const money = (amount: number) => `$${amount}`;

const tier = tiers[0];
const price = money(tier.priceMonthly);

const title = 'Partner with the Course';
const description = `One partner spot, ${price} a month: your brand in the partner directory and in the side rails on every page (the top strip on mobile).`;

const faqs = [
  {
    q: 'How much does a spot cost?',
    a: `${price} a month. One tier, month to month. No auction and no per-click fee.`,
  },
  {
    q: 'Where does my brand show?',
    a: 'In the partner directory, and in the side rails on desktop on every page. On mobile the side rails become the top strip.',
  },
  {
    q: 'Is it month to month?',
    a: 'Yes. Cancel anytime. Your spot stays until the end of the paid month. There is no annual contract.',
  },
  {
    q: 'What do you need from me?',
    a: 'A name, one line of copy, a link, and a mark if you have one. We edit the line so it fits the page, then send it back before it goes live.',
  },
  {
    q: 'What will you not run?',
    a: 'No porn, no gambling sites, no payday loans, and nothing that sells the habits this course is helping people leave.',
  },
  {
    q: 'Can the price change?',
    a: 'The price may rise as traffic grows. A partner who is already live keeps the rate they booked until they cancel.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: themeConfig.site },
    { '@type': 'ListItem', position: 2, name: 'Partner', item: new URL('/partner', themeConfig.site).toString() },
  ],
};
---

<Layout title={title} description={description}>
  <JsonLd data={faqLd} />
  <JsonLd data={breadcrumbs} />
  <nav aria-label="Breadcrumb" class="page-crumb">
    <a href="/">Home</a>
    <span aria-hidden="true"> / </span>
    <span>Partner</span>
  </nav>
  <p class="course-kicker">Partners</p>
  <h1 class="page-title">Partner with the course</h1>
  <p class="page-lead">One spot, one price, month to month. You get a plain placement, not a takeover.</p>

  <div class="sponsor-tiers sponsor-tiers-single">
    <section class="sponsor-tier">
      <h2>{tier.name}</h2>
      <p class="sponsor-tier-price">
        {price}
        <span>/mo</span>
      </p>
      <ul class="sponsor-tier-list">
        <li>Your brand in the partner directory</li>
        <li>The side rails on desktop, on every page</li>
        <li>The top strip on mobile, on every page</li>
        <li>Month to month. Cancel anytime.</li>
      </ul>
      <a class="btn-primary" href={tier.checkoutUrl} rel="noopener noreferrer" target="_blank">
        Become a partner
      </a>
    </section>
  </div>
  <style>
    .sponsor-tiers-single { display: block; max-width: 28rem; margin-inline: auto; }
    .sponsor-tiers-single .sponsor-tier { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 0.75rem; }
    .sponsor-tier-list { list-style: none; margin: 0.25rem 0 0.5rem; padding: 0; display: grid; gap: 0.4rem; }
    .sponsor-tier-list li { margin: 0; }
    .sponsor-tier-list li::before { content: '✓ '; font-weight: 700; }
  </style>

  <h2 class="page-subhead">Questions</h2>
  <div class="au-faq-list page-faqs">
    {faqs.map((faq) => (
      <details class="au-faq-item">
        <summary>{faq.q}</summary>
        <p>{faq.a}</p>
      </details>
    ))}
  </div>
  <SponsorCancel />
</Layout>
