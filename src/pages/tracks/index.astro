---
import MarbleAccent from '@components/course/MarbleAccent.astro';
import Layout from '@layouts/default.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import TrackCard from '@components/course/TrackCard.astro';
import FilterPills from '@components/course/FilterPills.astro';
import DoorSoonCard from '@components/course/DoorSoonCard.astro';
import { DOORS } from '@utils/doors';
import TopicRequest from '@components/course/TopicRequest.astro';
import { themeConfig } from '~/theme.config';
import { getTracks, lessonsForTrack } from '@utils/course';

const tracks = (await getTracks()).filter((track) => track.data.status === 'available');
const cards = await Promise.all(
  tracks.map(async (track) => ({
    track,
    lessonIds: (await lessonsForTrack(track.id)).map((lesson) => lesson.id),
  })),
);
const trackCategories = DOORS.map((d) => d.name);
const emptyDoors = DOORS.filter((d) => d.soon && !tracks.some((t) => t.data.category === d.name));
const doorRank = (c?: string) => { const i = DOORS.findIndex((d) => d.name === c); return i < 0 ? 99 : i; };
cards.sort((a, b) => doorRank(a.track.data.category) - doorRank(b.track.data.category));
const title = "Tracks: God's Love, Identity, Holiness and Initiative";
const description = 'Free Christian tracks in four doors: know God\'s love, know who you are, walk in holiness, take initiative. Includes a free 30-day reset for any addiction. For men and women.';

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: themeConfig.site },
    { '@type': 'ListItem', position: 2, name: 'Tracks', item: new URL('/tracks', themeConfig.site).toString() },
  ],
};
---

<Layout title={title} description={description}>
  <JsonLd data={breadcrumbs} />
  <nav aria-label="Breadcrumb" class="page-crumb">
    <a href="/">Home</a>
    <span aria-hidden="true"> / </span>
    <span>Tracks</span>
  </nav>
  <p class="course-kicker">Tracks</p>
  <div class="marble-head">
    <h1 class="page-title">Four doors, one direction</h1>
    <MarbleAccent kind="pillar" alt="" />
  </div>
  <p class="page-lead">
    Every track points to Jesus. Start with the door in front of you. If something has a hold on you, Break Free and the 30-day reset are in Walk in holiness. Days 1 to 7 are open here. The rest of the month comes by email.
  </p>
  <FilterPills categories={trackCategories} label="Filter tracks by topic" scope="tracks" />
  <div data-filter-scope="tracks">
  <ul class="track-grid page-stack">
    {cards.map(({ track, lessonIds }) => (
      <li data-filter-item data-category={track.data.category ?? 'Other'}>
        <TrackCard {track} {lessonIds} />
      </li>
    ))}
    {emptyDoors.map((door) => (
      <li data-filter-item data-category={door.name}>
        <DoorSoonCard {door} />
      </li>
    ))}
  </ul>
  <p class="filter-empty" data-filter-empty hidden>Nothing here yet in this topic.</p>
  </div>
  <TopicRequest source="tracks" />
</Layout>
