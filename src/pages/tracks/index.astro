---
import Layout from '@layouts/default.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import TrackCard from '@components/course/TrackCard.astro';
import { themeConfig } from '~/theme.config';
import { getTracks, lessonsForTrack } from '@utils/course';

const tracks = await getTracks();
const cards = await Promise.all(
  tracks.map(async (track) => ({
    track,
    lessonIds: track.data.status === 'available' ? (await lessonsForTrack(track.id)).map((lesson) => lesson.id) : [],
  })),
);
const title = 'Courses to Break Free and Build Discipline';
const description = 'Free course tracks for breaking free from addiction: porn, gaming, the phone, alcohol, substances, discipline, and a 30-day reset. Christian roots. Open to anyone.';

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: themeConfig.site },
    { '@type': 'ListItem', position: 2, name: 'Tracks', item: new URL('/tracks', themeConfig.site).toString() },
  ],
};
---

<Layout title={title} description={description}>
  <JsonLd data={breadcrumbs} />
  <nav aria-label="Breadcrumb" class="page-crumb">
    <a href="/">Home</a>
    <span aria-hidden="true"> / </span>
    <span>Tracks</span>
  </nav>
  <p class="course-kicker">Tracks</p>
  <h1 class="page-title">Break free, then build the day</h1>
  <p class="page-lead">
    These tracks are the course. The work is any addiction that is running the day — porn, gaming, the phone, alcohol, substances, or another habit — plus discipline and initiative. <strong>Break free from porn</strong> is the one you can take today. The others are written down so you can see the path, and marked coming soon until the lessons are ready. Christian roots. Open to anyone.
  </p>
  <ul class="track-grid page-stack">
    {cards.map(({ track, lessonIds }) => (
      <li>
        <TrackCard {track} {lessonIds} />
      </li>
    ))}
  </ul>
</Layout>
