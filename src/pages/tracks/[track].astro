---
import Layout from '@layouts/default.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import { render } from 'astro:content';
import { themeConfig } from '~/theme.config';
import MarbleAccent from '@components/course/MarbleAccent.astro';
import SupportLine from '@components/course/SupportLine.astro';
import Checklist from '@components/course/Checklist.astro';
import { publicImageExists, shareImage } from '@utils/public-image';
import ResetSignup from '@components/growth/ResetSignup.astro';
import { getTracks, lessonsForTrack, lessonPath, trackPath, type TrackEntry } from '@utils/course';

export async function getStaticPaths() {
  const tracks = await getTracks();
  return tracks.map((track) => ({
    params: { track: track.id },
    props: { track },
  }));
}

interface Props {
  track: TrackEntry;
}

const { track } = Astro.props as Props;
const { Content } = await render(track);
const lessons = await lessonsForTrack(track.id);
const mapPage = track.id === '30-day-reset';
const comingSoon = track.data.status === 'coming-soon';
const planned = comingSoon ? (track.data.plannedLessons ?? []) : [];
const cover = track.data.cover && publicImageExists(track.data.cover.src) ? track.data.cover : undefined;
const pageUrl = new URL(trackPath(track.id), themeConfig.site).toString();

const title = track.data.title;
// Short track blurbs make thin snippets. Add the lesson count and the first lesson for search.
const description =
  track.data.description.length < 110 && lessons.length > 0
    ? `${track.data.description} A free Christian course in ${lessons.length} short ${lessons.length === 1 ? 'lesson' : 'lessons'}, starting with "${lessons[0].data.title}".`
    : track.data.description;
const ogImage = await shareImage(cover);

const courseLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: track.data.title,
  description: track.data.description,
  url: pageUrl,
  inLanguage: 'en-US',
  isAccessibleForFree: true,
  provider: {
    '@type': 'Organization',
    name: themeConfig.name,
    url: themeConfig.site,
  },
  audience: {
    '@type': 'Audience',
    audienceType: 'Adults',
  },
  hasPart: lessons.map((lesson) => ({
    '@type': 'LearningResource',
    name: lesson.data.title,
    url: new URL(lessonPath(track.id, lesson.id), themeConfig.site).toString(),
    learningResourceType: 'Lesson',
  })),
};

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: themeConfig.site },
    { '@type': 'ListItem', position: 2, name: 'Tracks', item: new URL('/tracks', themeConfig.site).toString() },
    { '@type': 'ListItem', position: 3, name: track.data.title, item: pageUrl },
  ],
};
---

<Layout title={title} description={description} image={ogImage}>
  <JsonLd data={courseLd} />
  <JsonLd data={breadcrumbs} />
  <nav aria-label="Breadcrumb" class="page-crumb">
    <a href="/">Home</a>
    <span aria-hidden="true"> / </span>
    <a href="/tracks">Tracks</a>
    <span aria-hidden="true"> / </span>
    <span>{track.data.title}</span>
  </nav>
  <p class="course-kicker">{comingSoon ? 'Coming soon' : 'Course'}</p>
  <h1 class="page-title">{track.data.title}</h1>
  <p class="page-lead">{track.data.description}</p>
  {cover ? <img class="course-cover" src={cover.src} alt={cover.alt} width="1200" height="750" decoding="async" fetchpriority="high" /> : null}
  {lessons.length > 0 && (
    <section class="completion-card" data-track-complete data-lesson-ids={lessons.map((lesson) => lesson.id).join(',')} hidden>
      <MarbleAccent kind="laurel" alt="A marble laurel wreath" />
      <div>
        <p class="course-kicker">Course complete</p>
        <p>Every lesson in this track is marked done on this device.</p>
      </div>
    </section>
  )}
  {planned.length === 0 && !track.data.hideHabitBox && (<>
  <aside class="takeaway">
    <p class="course-kicker">Key takeaway</p>
    <p>Read what is open. Do the one step you can finish today. The free check writes a plan from your answers.</p>
  </aside>
  <ol class="habit-loop" aria-label="Habit loop">
    <li>
      <span class="habit-label">Trigger</span>
      <p>Notice the hour or feeling that starts the habit.</p>
    </li>
    <li>
      <span class="habit-label">Routine</span>
      <p>Name the habit in one word. Do not dress it up.</p>
    </li>
    <li>
      <span class="habit-label">Reward</span>
      <p>Decide the first ten minutes you will do instead.</p>
    </li>
  </ol>
  </>)}
  <div class="lesson-prose page-prose">
    <Content />
  </div>

  {mapPage ? (
    <div class="tracker-card">
      <Checklist
        id="30-day-tracker"
        title="30-day tracker"
        note="Tick each day when it is done. It saves on this device."
        variant="grid"
        countNoun="days done"
        items={Array.from({ length: 30 }, (_, i) => `Day ${i + 1}`)}
      />
    </div>
  ) : null}

  {mapPage ? <ResetSignup source="track:30-day-reset" /> : null}

  {lessons.length > 0 ? (
    <section class="page-stack" aria-labelledby="lesson-list-heading">
      <h2 id="lesson-list-heading" class="page-subhead">
        Lessons
      </h2>
      <ol class="mt-4 grid gap-3">
        {lessons.map((lesson, index) => (
          <li>
            <a class="track-card lesson-row" href={lessonPath(track.id, lesson.id)}>
              <span class="text-sm font-semibold text-stone-500">Lesson {index + 1}</span>
              <span class="text-lg font-bold">{lesson.data.title}</span>
              <span class="text-sm leading-relaxed text-stone-600 dark:text-stone-300">{lesson.data.description}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  ) : planned.length > 0 ? (
    <section class="page-stack" aria-labelledby="lesson-list-heading">
      <h2 id="lesson-list-heading" class="page-subhead">The {planned.length} lessons</h2>
      <ol class="mt-4 grid gap-3">
        {planned.map((lesson, index) => (
          <li><div class="track-card planned-lesson">
            <span class="text-sm font-semibold text-stone-500">Lesson {index + 1} · Coming soon</span>
            <span class="text-lg font-bold">{lesson.title}</span>
            {lesson.summary ? <span class="text-sm leading-relaxed text-stone-600 dark:text-stone-300">{lesson.summary}</span> : null}
          </div></li>
        ))}
      </ol>
    </section>
  ) : mapPage ? null : (
    <p class="mt-8 max-w-[68ch] leading-relaxed">
      This track has no lessons yet. Take the <a href="/check">free check</a>, read the <a href="/tracks/30-day-reset">30-day reset</a>, or start the open track, <a href="/tracks/break-free">Break Free</a>.
    </p>
  )}
  {track.id === 'teachings' ? <SupportLine /> : null}
</Layout>

<style>
  .lesson-row { display: flex !important; flex-direction: column; align-items: stretch; gap: 0.25rem; grid-template-columns: none !important; }
  .lesson-row > span { width: 100%; max-width: none; }
  .course-cover { width: 100%; max-width: 52rem; aspect-ratio: 16 / 10; object-fit: cover; height: auto; border-radius: 1.25rem; margin: 1.25rem 0 1.75rem; display: block; box-shadow: 0 12px 32px -18px rgb(0 0 0 / 0.45); }
  @media (min-width: 768px) { .course-cover { aspect-ratio: 16 / 9; max-height: 26rem; } }
  .planned-lesson { cursor: default; border-style: dashed; display: flex; flex-direction: column; align-items: flex-start; gap: .25rem; }
  .planned-lesson:hover { transform: none; }
</style>

<script>
  const STORAGE_KEY = 'reset:lesson-progress';

  function readDone(): string[] {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      const parsed = raw ? (JSON.parse(raw) as { done?: unknown }) : {};
      return Array.isArray(parsed.done) ? parsed.done.filter((id): id is string => typeof id === 'string') : [];
    } catch {
      return [];
    }
  }

  function paintTrackComplete() {
    const root = document.querySelector<HTMLElement>('[data-track-complete]');
    if (!root) return;
    const ids = (root.dataset.lessonIds || '').split(',').filter(Boolean);
    const done = readDone();
    root.hidden = ids.length === 0 || !ids.every((id) => done.includes(id));
  }

  paintTrackComplete();
  document.addEventListener('astro:page-load', paintTrackComplete);
</script>
