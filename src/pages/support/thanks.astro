---
import Layout from '@layouts/default.astro';

const title = 'Thank You';
const description = 'Thank you for supporting the work. This is support for the work, not a tax-deductible donation.';
---

<Layout title={title} description={description}>
  <p class="course-kicker">Support</p>
  <h1 class="page-title">Thank you</h1>
  <div class="lesson-prose page-prose">
    <p>You supported the work. That keeps this course free for the next person.</p>
    <p>This is support for the work. It is not a tax-deductible donation.</p>
    <p>
      <a href="/tracks">Back to the course</a>
    </p>
  </div>
</Layout>
