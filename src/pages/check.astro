---
import Layout from '@layouts/default.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import { themeConfig } from '~/theme.config';

const title = 'See Where You Are';
const description = 'A free check that shows where you are right now and suggests a place to start. If something has a hold on you, it writes a 30-day reset for it. It runs in your browser.';
const pageUrl = new URL('/check', themeConfig.site).toString();

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: themeConfig.site },
    { '@type': 'ListItem', position: 2, name: 'Free check', item: pageUrl },
  ],
};
---

<Layout title={title} description={description}>
  <JsonLd data={breadcrumbs} />
  <nav aria-label="Breadcrumb" class="page-crumb">
    <a href="/">Home</a>
    <span aria-hidden="true"> / </span>
    <span>Free check</span>
  </nav>
  <p class="course-kicker">Free check</p>
  <h1 class="page-title">See where you are</h1>
  <p class="page-lead">Answer nine short questions. You get one track to open next, and if there is something you want to be free from, a 30-day reset shaped for it. Email is optional. Nothing is stored until you submit.</p>
  <div id="check-app" class="check-app" aria-live="polite"></div>
  <noscript>
    <p class="mt-6 max-w-[68ch]">
      This check runs in the browser. Enable JavaScript to answer the questions. You can still read <a href="/tracks/30-day-reset">the 30-day reset</a>, <a href="/tracks">every track</a>, or <a href="/tracks/break-free">Break Free</a>.
    </p>
  </noscript>
</Layout>

<script>
  import { mountCheckQuiz } from '@scripts/check-page';

  function bootCheck() {
    const root = document.getElementById('check-app');
    if (!(root instanceof HTMLElement)) return;
    mountCheckQuiz(root);
  }

  document.addEventListener('astro:page-load', bootCheck);
  bootCheck();
</script>
