---
import Layout from '@layouts/default.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import { themeConfig } from '~/theme.config';

const price = themeConfig.advertise?.priceMonthly ?? 50;
const bookingUrl = themeConfig.advertise?.bookingUrl ?? 'https://example.com/book-a-spot';
const priceLabel = `$${price}`;
const title = 'Advertise on the Course';
const description = `Advertise for a flat ${priceLabel} a month, month to month. The price rises as traffic grows. A sponsor card on mobile, on desktop rails, and on course pages.`;

const faqs = [
  {
    q: 'How much does a spot cost?',
    a: `A spot is a flat ${priceLabel} a month. There is no auction and no per-click fee. The price rises as traffic grows. The rate on this page is the rate for a new booking.`,
  },
  {
    q: 'Is it month to month?',
    a: 'Yes. Month to month. You can stop before the next month. There is no annual contract.',
  },
  {
    q: 'Where does the card show?',
    a: 'One sponsor shows in a sticky strip at the top on phones, in sticky side rails on a wide desktop, and as one card on each course page. The card is chosen at random on each page load so placements stay even.',
  },
  {
    q: 'What do you need from me?',
    a: 'A name, one line of copy, a link, and a mark if you have one. We edit the line so it fits the page, then send it back before it goes live.',
  },
  {
    q: 'What will you not run?',
    a: 'No porn, no gambling sites, no payday loans, and nothing that sells the habits this course is helping men leave.',
  },
  {
    q: 'When does the price change?',
    a: 'The price rises as traffic grows. A sponsor who is already live keeps the rate they booked until they cancel. A new sponsor pays the rate posted that day.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: themeConfig.site },
    { '@type': 'ListItem', position: 2, name: 'Advertise', item: new URL('/advertise', themeConfig.site).toString() },
  ],
};
---

<Layout title={title} description={description}>
  <JsonLd data={faqLd} />
  <JsonLd data={breadcrumbs} />
  <nav aria-label="Breadcrumb" class="mb-4 text-sm">
    <a href="/">Home</a>
    <span aria-hidden="true"> / </span>
    <span>Advertise</span>
  </nav>
  <p class="course-kicker">Sponsors</p>
  <h1 class="mt-2 max-w-[16ch] text-4xl font-bold tracking-tight">Advertise beside men who are doing the work</h1>
  <p class="mt-4 max-w-[68ch] text-lg leading-relaxed">
    A spot is <strong>{priceLabel} a month</strong>, month to month. The price rises as traffic grows. You get a plain card, not a takeover.
  </p>
  <p class="mt-4">
    <a class="btn-primary" href={bookingUrl} rel="noopener" target="_blank">Book a spot</a>
  </p>
  <p class="mt-3 max-w-[68ch] text-sm text-stone-600 dark:text-stone-300">The booking link is a placeholder until a real checkout is connected. Change it in the site config.</p>

  <h2 class="mt-10 text-2xl font-bold">What a spot includes</h2>
  <ul class="mt-3 max-w-[68ch] list-disc space-y-2 pl-5 leading-relaxed">
    <li>A sticky strip at the top of the page on a phone.</li>
    <li>Sticky side rails on a wide desktop screen.</li>
    <li>One card on each course page.</li>
    <li>A link tagged so you can see which placement was clicked.</li>
  </ul>
  <p class="mt-4 max-w-[68ch] leading-relaxed">
    The open course right now is <a href="/tracks/break-free-from-porn">break free from porn</a>. Empty slots say “Your brand here – Advertise” and point here.
  </p>

  <h2 class="mt-10 text-2xl font-bold">Questions</h2>
  <div class="mt-4 max-w-[68ch] divide-y divide-stone-300/70 dark:divide-white/15">
    {
      faqs.map((faq) => (
        <details class="py-3">
          <summary class="cursor-pointer text-lg font-semibold">{faq.q}</summary>
          <p class="mt-2 leading-relaxed">{faq.a}</p>
        </details>
      ))
    }
  </div>
</Layout>
