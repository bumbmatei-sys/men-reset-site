---
import Layout from '@layouts/default.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import TrackCard from '@components/course/TrackCard.astro';
import DoorSoonCard from '@components/course/DoorSoonCard.astro';
import { DOORS } from '@utils/doors';
import MarbleAccent from '@components/course/MarbleAccent.astro';
import { themeConfig } from '~/theme.config';
import { getTeachings, toCard, formatDate } from '@utils/teachings';
import '../styles/teachings.css';
import { getTracks, lessonsForTrack, lessonPath, trackPath } from '@utils/course';

const locale = themeConfig.i18n.defaultLocale;
const tracks = (await getTracks()).filter((track) => track.data.status === 'available');
const cards = await Promise.all(
  tracks.map(async (track) => ({
    track,
    lessonIds: (await lessonsForTrack(track.id)).map((lesson) => lesson.id),
  })),
);
const live = cards.find((card) => card.track.data.status === 'available');
const startHref = live && live.lessonIds[0] ? lessonPath(live.track.id, live.lessonIds[0]) : '/tracks';

const latestTeachings = (await getTeachings())
  .filter((entry) => !entry.data.draft)
  .map(toCard)
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 3);

const title = "Know God's Love, Know Who You Are in Christ, and Live It Out";
const description = "Free Christian lessons on God's love, your identity in Christ, a holy life and taking initiative. Freedom from addiction is one path inside it. Grace first. For men and women.";

const steps = [
  {
    n: '01',
    title: "See where you're going",
    body: 'A free check shows where you are right now and suggests where to start. If something has a hold on you, the free 30-day reset is there. Days 1 to 7 are open on the site. Days 8 to 30 come as a PDF by email.',
    cta: 'Take the free check',
    href: '/check',
    external: false,
    image: '/aureum/process-01.webp',
    alt: 'Marble scholar with a spyglass',
  },
  {
    n: '02',
    title: 'Grow step by step',
    body: "Short tracks on God's love, your identity in Christ, a holy life and taking initiative. Pick the one in front of you.",
    cta: 'See the tracks',
    href: '/tracks',
    external: false,
    image: '/aureum/process-02.webp',
    alt: 'Marble figure with a compass and a scroll',
  },
  {
    n: '03',
    title: "You're not alone",
    body: 'A community of people walking the same road. Join the room, not a feed.',
    cta: 'Join the community',
    href: themeConfig.communityUrl,
    external: true,
    image: '/aureum/process-03.webp',
    alt: 'Two marble figures seated at a desk',
  },
  {
    n: '04',
    title: 'Grow further',
    body: 'Private coaching for growing further into your God-given mission. Private community + 1:1 sessions.',
    cta: 'Apply soon',
    href: themeConfig.communityUrl,
    external: true,
    image: '/aureum/process-04.webp',
    alt: 'Marble staircase',
  },
];

const stats = [
  { figure: '30 days', label: 'A free 30-day reset to help you walk free from what holds you back.' },
  { figure: '9 questions', label: 'A free check you can finish in one sitting' },
  { figure: '4 steps', label: 'The path from the check into the first steps of your new life.' },
];


const faqs = [
  {
    q: 'Is the course free?',
    a: 'Yes. The lessons that are open can be read with no account and no payment. Partnership does not unlock a lesson.',
  },
  {
    q: 'Do I have to be a Christian?',
    a: 'The roots are Christian. You do not have to share that faith to use the steps. The writing stays plain.',
  },
  {
    q: 'Is this only about addiction?',
    a: "No. The site is about knowing God's love, knowing who you are in Christ, living a holy life and taking initiative. Freedom from addiction is one part of that. If something has a hold on you, Break Free and the 30-day reset are there, and the check writes a plan for what you name.",
  },
  {
    q: 'What if I am under 18?',
    a: 'The site is for everyone. Young people need to know who they are in Christ too. The content stays clean, with no sexual detail.',
  },
  {
    q: 'Where is the partner price?',
    a: 'On the partner page. There is one partner spot, billed monthly. The home page does not list prices.',
  },
];

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Course tracks',
  itemListElement: tracks.map((track, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: track.data.title,
    url: new URL(trackPath(track.id), themeConfig.site).toString(),
  })),
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const marqueeWords = ['Love', 'Identity', 'Holiness', 'Initiative'];
const marquee = [...marqueeWords, ...marqueeWords];
---

<Layout isHome showHero={false} noContainer title={title} description={description} locale={locale}>
  <JsonLd data={itemList} />
  <JsonLd data={faqLd} />
  <div class="au-home">
    <section class="au-hero" id="hero">
      <img class="au-hero-bg" src="/aureum/hero-landscape.webp" alt="" width="1448" height="1086" />
      <div class="au-hero-shade" aria-hidden="true"></div>
      <div class="au-hero-copy">
        <h1>
          <span class="au-h1-line">Know His love.</span>
          <span class="au-h1-line">Know who you are.</span>
          <span class="au-h1-line">Live it out.</span>
        </h1>
      </div>
      <p class="au-word" aria-hidden="true">
        Reset
      </p>
      <img class="au-figure au-figure-left" src="/aureum/bust.webp" alt="" width="1000" height="1274" />
      <img class="au-figure au-figure-right" src="/aureum/bust.webp" alt="" width="1000" height="1274" />
    </section>

    <section class="au-band au-intro" id="intro">
      <div class="au-wrap au-intro-copy">
        <p class="au-lead">It starts with God's love. Jesus loves you right where you are, and in Him you have a new identity. From there, whatever holds you back, sin, an addiction, fear or no direction at all, there is a way forward. One step at a time, with Him.</p>
        <p class="au-note">The foundations are Christian. Everyone is welcome, men and women.</p>
        <div class="au-actions">
          <a class="au-pill" href="/check">
            Take the free check
          </a>
          <a class="au-pill au-pill-ghost" href={startHref}>
            Start the first lesson
          </a>
          <a class="au-textlink" href="/tracks">
            See every track
          </a>
        </div>
      </div>
    </section>

    <section class="au-band au-problem" id="problem">
      <div class="au-wrap">
        <p class="au-kicker au-reveal">What holds you back</p>
        <h2 class="au-display au-reveal">You were made for more than this.</h2>
        <p class="au-section-lead au-reveal">For some it's a habit that won't let go. For others it's shame, fear, or just drifting with no direction. It repeats, and after a while it starts to feel like who you are. It isn't.</p>
        <article class="au-problem-card au-reveal">
          <img src="/aureum/problem.webp" alt="Marble figures bent over scrolls" width="720" height="526" />
          <div>
            <h3>You don't have to stay there</h3>
            <p>Hiding it doesn't make it smaller. This site names things in plain words, points you to Jesus, and gives you a practical next step. Grace first. Then the walk.</p>
          </div>
        </article>
      </div>
    </section>

    <section class="au-band au-impact" id="impact">
      <div class="au-wrap">
        <div class="au-impact-head">
          <div>
            <p class="au-kicker au-reveal">Impact</p>
            <h2 class="au-display au-reveal">What you can start today</h2>
            <p class="au-section-lead au-reveal">These are the pieces of the course, not results we are claiming. No invented counts.</p>
          </div>
          <div class="au-reveal">
            <MarbleAccent kind="spheres" alt="Three marble spheres" />
          </div>
        </div>
        <ul class="au-stats">
          {stats.map((stat) => (
            <li class="au-stat au-reveal">
              <span class="au-stat-figure">{stat.figure}</span>
              <span class="au-stat-label">{stat.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="au-process" id="process" data-process>
      <div class="au-process-pin">
        <div class="au-process-label au-process-head">
          <p class="au-kicker">The path</p>
          <MarbleAccent kind="flow" alt="Marble diagram of four connected steps" />
        </div>
        <ol class="au-steps">
          {steps.map((step, index) => (
            <li class:list={['au-step', index === 0 && 'is-active']} data-step>
              <div class="au-step-copy">
                <span class="au-step-num">{step.n}</span>
                <h2>{step.title}</h2>
                <p>{step.body}</p>
                <a class="au-textlink" href={step.href} target={step.external ? '_blank' : undefined} rel={step.external ? 'noopener noreferrer' : undefined}>
                  {step.cta} <span aria-hidden="true">→</span>
                </a>
              </div>
              <img class="au-step-image" src={step.image} alt={step.alt} width="1400" height="1867" />
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="au-band" id="tracks">
      <div class="au-wrap">
        <p class="au-kicker au-reveal">Tracks</p>
        <h2 class="au-display au-reveal">Four doors. Start with the one in front of you.</h2>
        <p class="au-section-lead au-reveal">It doesn't matter where you start. Everything here points to the same place: knowing Jesus and living from who He says you are. New lessons are added often.</p>
        <div class="au-doors">
          {DOORS.map((door) => {
            const inDoor = cards.filter(({ track }) => track.data.category === door.name);
            return (
              <section class="au-door au-reveal">
                <h3 class="au-door-title">{door.name}</h3>
                <p class="au-door-text">{door.text}</p>
                <ul class="track-grid au-track-grid">
                  {inDoor.map(({ track, lessonIds }) => (
                    <li><TrackCard {track} {lessonIds} /></li>
                  ))}
                  {inDoor.length === 0 && door.soon ? <li><DoorSoonCard {door} /></li> : null}
                </ul>
              </section>
            );
          })}
        </div>
      </div>
    </section>

    {latestTeachings.length > 0 && (
      <section class="au-band au-teachings" id="teachings">
        <div class="au-wrap">
          <div class="au-teachings-head">
            <div>
              <p class="au-kicker au-reveal">Teachings</p>
              <h2 class="au-display au-reveal">Read something true today</h2>
              <p class="au-section-lead au-reveal">Short teachings on identity in Christ, grace and freedom. Plain words, one point at a time.</p>
            </div>
            <div class="au-reveal">
              <MarbleAccent kind="laurel" alt="" />
            </div>
          </div>
          <div class="tch au-teachings-grid">
            <ul class="tch-highlights">
              {latestTeachings.map((c) => (
                <li class="au-reveal">
                  <a class={`tch-overlay${c.image ? '' : ' tch-noimg'}`} href={c.href}>
                    {c.image ? <img src={c.image.src} alt={c.image.alt} width="640" height="640" loading="lazy" decoding="async" /> : null}
                    <span class="tch-overlay-label">
                      <span class="tch-kicker">{c.category}</span>
                      <span class="tch-overlay-title">{c.title}</span>
                      <span class="tch-meta"><time datetime={c.date.toISOString()}>{formatDate(c.date)}</time> · {c.minutes} min read</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <a class="au-textlink au-reveal au-teachings-all" href="/teachings">
            All teachings <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    )}

    <section class="au-lesson" id="lesson">
      <div class="au-wrap au-lesson-grid">
        <div>
          <p class="au-kicker">A lesson</p>
          <h2 class="au-display">How the courses work</h2>
        </div>
        <div>
          <p>Each course is a short set of lessons, one point at a time.</p>
          <ul>
            <li>One point per lesson, short enough to remember without a notebook.</li>
            <li>One scripture, explained in plain words.</li>
            <li>One action step and one reflection question.</li>
            <li>Your progress is saved on this device only.</li>
          </ul>
          <p>
            The 30-day PDF plan is separate. You get it by email from the free <a href="/check">check</a>. The <a href="/partner">partner</a> page is for brands, not for the work itself.
          </p>
        </div>
      </div>
    </section>

    <section class="au-clients au-clients-marquee" id="words">
      <div class="au-marquee" aria-hidden="true">
        <div class="au-marquee-track">
          {marquee.map((word) => (
            <span>{word}</span>
          ))}
        </div>
      </div>
    </section>

    <section class="au-band au-faq" id="faq">
      <div class="au-wrap au-faq-grid">
        <div>
          <p class="au-kicker">Questions</p>
          <h2 class="au-display">Before you start</h2>
        </div>
        <div class="au-faq-list">
          {faqs.map((item) => (
            <details class="au-faq-item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="au-cta-band" id="start">
      <div class="au-wrap">
        <div class="au-cta">
          <div class="au-cta-copy">
            <p class="au-kicker au-kicker-light">Today</p>
            <h2>Start today. He's already there.</h2>
            <div class="au-actions">
              <a class="au-pill" href="/check">
                Take the free check
              </a>
              <a class="au-pill au-pill-ghost" href={startHref}>
                Start the first lesson
              </a>
            </div>
          </div>
          <div class="au-cta-art" aria-hidden="true">
            <img src="/aureum/bust.webp" alt="" width="1000" height="1274" />
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style is:global>
  .au-teachings-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; }
  .au-teachings-head .marble-accent, .au-teachings-head img { max-width: 7rem; height: auto; }
  @media (max-width: 639px) { .au-teachings-head > div:last-child { display: none; } }
  .au-teachings-grid { max-width: none; padding-bottom: 0; }
  .au-teachings-grid .tch-highlights { margin-top: 2rem; }
  .au-teachings-all { display: inline-block; margin-top: 1.6rem; }
  .au-clients-marquee { padding-block: 2.5rem; }
  .au-doors { display: grid; gap: 2.5rem; margin-top: 2rem; }
  .au-door-title { font-size: 1.6rem; margin: 0 0 .35rem; }
  .au-door-text { margin: 0 0 1rem; opacity: .85; max-width: 60ch; }
  .au-door .au-track-grid { margin-top: 0; }
</style>
