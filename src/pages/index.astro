---
import Layout from '@layouts/default.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import TrackCard from '@components/course/TrackCard.astro';
import { themeConfig } from '~/theme.config';
import { getTracks, lessonsForTrack, lessonPath, trackPath } from '@utils/course';
import sponsors from '@data/sponsors.json' with { type: 'json' };

const locale = themeConfig.i18n.defaultLocale;
const tracks = await getTracks();
const cards = await Promise.all(
  tracks.map(async (track) => ({
    track,
    lessonIds: track.data.status === 'available' ? (await lessonsForTrack(track.id)).map((lesson) => lesson.id) : [],
  })),
);
const live = cards.find((card) => card.track.data.status === 'available');
const startHref = live && live.lessonIds[0] ? lessonPath(live.track.id, live.lessonIds[0]) : '/tracks';

const title = 'How to Quit Porn and Build Discipline';
const description = 'A free course for men who want to stop watching porn, quit gaming and the phone, and build a disciplined morning. Christian roots. Open to anyone.';

const steps = [
  {
    n: '01',
    title: "See where you're going",
    body: "A free self-check shows where you're stuck. Then you get a free 30-day reset written from those answers.",
    cta: 'Take the free check',
    href: '/check',
    external: false,
    image: '/aureum/process-01.webp',
    alt: 'Marble scholar with a spyglass',
  },
  {
    n: '02',
    title: 'Build your future, step by step',
    body: 'Practical teachings based on Paul Manwaring. The track is being written. This page does not invent quotes.',
    cta: 'Open the teachings track',
    href: '/tracks/teachings',
    external: false,
    image: '/aureum/process-02.webp',
    alt: 'Marble figure with a compass and a scroll',
  },
  {
    n: '03',
    title: "You're not alone",
    body: 'A real community of men on Whop. The join link is a placeholder until that room is open.',
    cta: 'Join the community',
    href: themeConfig.communityUrl,
    external: true,
    image: '/aureum/process-03.webp',
    alt: 'Two marble hands',
  },
  {
    n: '04',
    title: 'Grow further',
    body: 'Paid 1:1 coaching with Matei, plus a paid community with premium content. The application link is a placeholder.',
    cta: 'Apply for coaching',
    href: themeConfig.coachingUrl,
    external: true,
    image: '/aureum/process-04.webp',
    alt: 'Marble staircase',
  },
];

const stats = [
  { figure: 'PLACEHOLDER', label: 'Men who kept one week' },
  { figure: 'PLACEHOLDER', label: 'Days the plan was followed' },
  { figure: 'PLACEHOLDER', label: 'Lessons finished' },
];

const notes = [
  { quote: 'Placeholder line. This is not a real review.', name: 'Placeholder' },
  { quote: 'Placeholder line. No man said this.', name: 'Placeholder' },
  { quote: 'Placeholder line. Waiting on real words.', name: 'Placeholder' },
];

const faqs = [
  {
    q: 'Is the course free?',
    a: 'Yes. The lessons that are open can be read with no account and no payment. Sponsorship does not unlock a lesson.',
  },
  {
    q: 'Do I have to be a Christian?',
    a: 'The roots are Christian. You do not have to share that faith to use the steps. The writing stays plain.',
  },
  {
    q: 'What if I am under 18?',
    a: 'The free check stops. This course is for adults. It will not give sexual how-to, and it does not save an under-18 answer.',
  },
  {
    q: 'Where are the sponsor prices?',
    a: 'Only on the sponsor page. They are starting prices and they rise as traffic grows. The home page does not list them.',
  },
];

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Course tracks',
  itemListElement: tracks.map((track, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: track.data.title,
    url: new URL(trackPath(track.id), themeConfig.site).toString(),
  })),
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const marquee = [...sponsors, ...sponsors, ...sponsors, ...sponsors];
---

<Layout isHome showHero={false} noContainer title={title} description={description} locale={locale}>
  <JsonLd data={itemList} />
  <JsonLd data={faqLd} />
  <div class="au-home">
    <section class="au-hero" id="hero">
      <img class="au-hero-bg" src="/aureum/hero-landscape.webp" alt="" width="1672" height="848" />
      <div class="au-hero-shade" aria-hidden="true"></div>
      <div class="au-hero-copy">
        <p class="au-kicker au-kicker-light">For men</p>
        <h1>How to quit porn<br />and build discipline</h1>
      </div>
      <p class="au-word" aria-hidden="true">Reset</p>
      <img class="au-figure au-figure-left" src="/aureum/reclining.webp" alt="" width="1100" height="1225" />
      <img class="au-figure au-figure-right" src="/aureum/bust.webp" alt="" width="1000" height="1274" />
    </section>

    <section class="au-band au-intro" id="intro">
      <div class="au-wrap au-intro-copy">
        <p class="au-lead">
          <strong>How to quit porn</strong> is not a mood. It is a set of small moves you can repeat on a tired Tuesday. This course is for men who are done hiding the tab, the late-night game, the phone, or the drink.
        </p>
        <p class="au-note">The roots are Christian. You do not have to share that faith to use the steps. The writing stays plain. No hype. No fake before-and-after.</p>
        <div class="au-actions">
          <a class="au-pill" href="/check">
            Take the free check
          </a>
          <a class="au-pill au-pill-ghost" href={startHref}>
            Start the first lesson
          </a>
          <a class="au-textlink" href="/tracks">
            See every track
          </a>
        </div>
      </div>
    </section>

    <section class="au-band au-problem" id="problem">
      <div class="au-wrap">
        <p class="au-kicker au-reveal">The trap</p>
        <h2 class="au-display au-reveal">The night takes the day</h2>
        <p class="au-section-lead au-reveal">The tab, the match, the scroll, the drink. It starts as a break. It ends as the evening, and the morning is already spent.</p>
        <article class="au-problem-card au-reveal">
          <img src="/aureum/problem.webp" alt="Marble figures bent over scrolls" width="720" height="526" />
          <div>
            <h3>You already know the pattern</h3>
            <p>Hiding it did not make it smaller. This course names the fight in plain words, then gives you one move for today. Not a new identity slogan. A next step.</p>
          </div>
        </article>
      </div>
    </section>

    <section class="au-band au-impact" id="impact">
      <div class="au-wrap">
        <p class="au-kicker au-reveal">Impact</p>
        <h2 class="au-display au-reveal">Numbers we will not invent</h2>
        <p class="au-section-lead au-reveal">These three cards are placeholders. The word PLACEHOLDER is the figure on purpose. Real counts go here only when we have them.</p>
        <ul class="au-stats">
          {stats.map((stat) => (
            <li class="au-stat au-reveal">
              <span class="au-stat-flag">Placeholder</span>
              <span class="au-stat-figure">{stat.figure}</span>
              <span class="au-stat-label">{stat.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="au-process" id="process" data-process>
      <div class="au-process-pin">
        <p class="au-kicker au-process-label">The path</p>
        <ol class="au-steps">
          {steps.map((step, index) => (
            <li class:list={['au-step', index === 0 && 'is-active']} data-step>
              <div class="au-step-copy">
                <span class="au-step-num">{step.n}</span>
                <h2>{step.title}</h2>
                <p>{step.body}</p>
                <a class="au-textlink" href={step.href} target={step.external ? '_blank' : undefined} rel={step.external ? 'noopener noreferrer' : undefined}>
                  {step.cta} <span aria-hidden="true">→</span>
                </a>
              </div>
              <img class="au-step-image" src={step.image} alt={step.alt} width="1400" height="746" />
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="au-band" id="tracks">
      <div class="au-wrap">
        <p class="au-kicker au-reveal">Tracks</p>
        <h2 class="au-display au-reveal">Start with the fight in front of you</h2>
        <p class="au-section-lead au-reveal">
          One track is open. The rest are marked coming soon, including a free <a href="/tracks/30-day-reset">30-day reset</a>. Start with <a href="/tracks/break-free-from-porn">break free from porn</a> if that is the fight in front of you.
        </p>
        <ul class="track-grid au-track-grid">
          {cards.map(({ track, lessonIds }) => (
            <li class="au-reveal">
              <TrackCard {track} {lessonIds} />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="au-lesson" id="lesson">
      <div class="au-wrap au-lesson-grid">
        <div>
          <p class="au-kicker">A lesson</p>
          <h2 class="au-display">How a lesson works</h2>
        </div>
        <div>
          <p>Each lesson is a 5–10 minute read. You get the point up front, then a practice you can do today.</p>
          <ul>
            <li>Key points you can remember without a notebook.</li>
            <li>One scripture, quoted in the King James Version, then one plain line on what to do with it.</li>
            <li>An action step and a reflection question.</li>
            <li>Your place in the track, saved on this device only.</li>
          </ul>
          <p>
            If porn is the issue, read <a href="/tracks/break-free-from-porn/how-to-stop-watching-porn">how to stop watching porn</a>, then <a href="/tracks/break-free-from-porn/how-to-deal-with-porn-urges">how to deal with porn urges</a>. The <a href="/sponsor">sponsor</a> page is for brands, not for the work itself.
          </p>
        </div>
      </div>
    </section>

    <section class="au-clients" id="notes">
      <div class="au-wrap">
        <p class="au-kicker au-kicker-light au-reveal">Notes</p>
        <h2 class="au-display au-reveal">What men say</h2>
        <p class="au-section-lead au-light au-reveal">Example lines only. These are not reviews, and they are not testimonials from real men.</p>
        <ul class="au-notes">
          {notes.map((note) => (
            <li class="au-note-card au-reveal">
              <span class="au-stat-flag">Placeholder</span>
              <blockquote>{note.quote}</blockquote>
              <cite>{note.name}</cite>
            </li>
          ))}
        </ul>
      </div>
      <div class="au-marquee" aria-hidden="true">
        <div class="au-marquee-track">
          {marquee.map((sponsor) => (
            <span>
              {sponsor.tier} · {sponsor.name}
            </span>
          ))}
        </div>
      </div>
    </section>

    <section class="au-band au-faq" id="faq">
      <div class="au-wrap au-faq-grid">
        <div>
          <p class="au-kicker">Questions</p>
          <h2 class="au-display">Before you start</h2>
        </div>
        <div class="au-faq-list">
          {faqs.map((item) => (
            <details class="au-faq-item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="au-cta-band" id="start">
      <div class="au-wrap">
        <div class="au-cta">
          <div class="au-cta-copy">
            <p class="au-kicker au-kicker-light">Today</p>
            <h2>Start the work while the day is still yours</h2>
            <div class="au-actions">
              <a class="au-pill" href="/check">
                Take the free check
              </a>
              <a class="au-pill au-pill-ghost" href={startHref}>
                Start the first lesson
              </a>
            </div>
          </div>
          <div class="au-cta-art" aria-hidden="true">
            <img src="/aureum/reclining.webp" alt="" width="1100" height="1225" />
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
