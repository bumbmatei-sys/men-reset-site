---
import Layout from '@layouts/default.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import SponsorCancel from '@components/sponsors/SponsorCancel.astro';
import { themeConfig } from '~/theme.config';
import { SPONSORS_ENABLED } from '@data/site';

if (!SPONSORS_ENABLED) {
  return Astro.redirect('/');
}
import { sponsorUrl, sponsors } from '@utils/sponsors';

const title = 'Partners';
const description = `Brands listed on ${themeConfig.name}. Every partner is listed here.`;

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: themeConfig.site },
    { '@type': 'ListItem', position: 2, name: 'Partners', item: new URL('/partners', themeConfig.site).toString() },
  ],
};

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Partners',
  itemListElement: sponsors.map((sponsor, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: sponsor.name,
    url: new URL(sponsor.url, themeConfig.site).toString(),
  })),
};
---

<Layout title={title} description={description}>
  <JsonLd data={breadcrumbs} />
  <JsonLd data={itemList} />
  <nav aria-label="Breadcrumb" class="page-crumb">
    <a href="/">Home</a>
    <span aria-hidden="true"> / </span>
    <span>Partners</span>
  </nav>
  <p class="course-kicker">Directory</p>
  <h1 class="page-title">Partners</h1>
  <div class="choice-cards">
    <section class="choice-card">
      <p class="course-kicker">For individuals</p>
      <h2>Support the mission</h2>
      <p>Give what you can and keep these lessons free for the next person.</p>
      <a class="btn-primary" href="/support">Support the mission</a>
    </section>
    <section class="choice-card">
      <p class="course-kicker">For businesses and ministries</p>
      <h2>Become a partner</h2>
      <p>Show your brand in the partner strip and in the directory below.</p>
      <a class="btn-primary" href="/partner">See partner options</a>
    </section>
  </div>
  <style>
    .choice-cards { display: grid; gap: 1rem; margin: 1.5rem 0 2rem; }
    @media (min-width: 768px) { .choice-cards { grid-template-columns: 1fr 1fr; } }
    .choice-card { border: 1px solid color-mix(in srgb, currentColor 18%, transparent); border-radius: 1rem; padding: 1.5rem; display: flex; flex-direction: column; gap: .75rem; align-items: flex-start; }
    .choice-card h2 { margin: 0; font-size: 1.5rem; }
    .choice-card p { margin: 0; }
    .choice-card a { margin-top: auto; }
  </style>
  <h2 class="page-subtitle">Our partners</h2>
  <p class="page-lead">The Harvest partners with this site. One spot is still open.</p>
  <ul class="sponsor-directory">
    {sponsors.map((sponsor) => {
      const href = sponsorUrl(sponsor.url, 'directory');
      const external = href.startsWith('http');
      const open = sponsor.id.startsWith('placeholder');
      return (
        <li>
          <a class="sponsor-card" href={href} rel={external ? 'sponsored noopener' : 'sponsored'} target={external ? '_blank' : undefined}>
            {open ? <span class="au-stat-flag">Open spot</span> : null}
            {sponsor.logo ? <img class="sponsor-logo" src={sponsor.logo} alt="" width="480" height="796" /> : null}
            <span class="sponsor-name">{sponsor.name}</span>
            <span class="sponsor-tagline">{sponsor.tagline}</span>
            <span class="sponsor-cta">{sponsor.cta}</span>
          </a>
        </li>
      );
    })}
  </ul>
  <SponsorCancel />
</Layout>
