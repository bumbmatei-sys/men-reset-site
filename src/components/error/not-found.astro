---
import Layout from '@layouts/default.astro';
import { useTranslations } from '@utils/i18n';

interface Props {
  locale: string;
  localized404Paths?: Record<string, string>;
}

const { locale, localized404Paths } = Astro.props as Props;
const t = useTranslations(locale);
---

<Layout title={t('pages.404.title')} description={t('pages.404.message')} isError {locale} header={{ showTopBanner: false }} showFooterBanner={false}>
  <div data-localized-404-paths={localized404Paths ? JSON.stringify(localized404Paths) : undefined}>
    <p class="course-kicker">404</p>
    <h1 class="page-title">{t('pages.404.title')}</h1>
    <p class="page-lead">{t('pages.404.message')}</p>
    <div class="page-actions">
      <a class="btn-primary" href="/">
        Back to the homepage
      </a>
      <a class="btn-secondary" href="/tracks">
        See the tracks
      </a>
    </div>
  </div>

  {localized404Paths && <script is:inline>
    const pathLocale = window.location.pathname.split('/').filter(Boolean)[0];
    const serializedPaths = document.querySelector('[data-localized-404-paths]')?.getAttribute('data-localized-404-paths');
    const localized404Path = serializedPaths ? Object.entries(JSON.parse(serializedPaths)).find(([locale]) => locale === pathLocale)?.[1] : undefined;

    if (localized404Path) window.location.replace(localized404Path);
  </script>}
</Layout>
