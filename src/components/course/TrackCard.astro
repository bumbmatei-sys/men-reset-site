---
import { trackPath, type TrackEntry } from '@utils/course';
import { publicImageExists } from '@utils/public-image';

interface Props {
  track: TrackEntry;
  lessonIds?: string[];
}

const { track, lessonIds = [] } = Astro.props;
const open = track.data.status === 'available';
const cover = track.data.cover && publicImageExists(track.data.cover.src) ? track.data.cover : undefined;
const icon = publicImageExists(track.data.icon) ? track.data.icon : undefined;
const category = track.data.category ?? 'Other';
const planned = open ? [] : (track.data.plannedLessons ?? []);
---

<a class="track-card track-card-split reveal" href={trackPath(track.id)} data-track-card data-category={category} data-lesson-ids={open ? lessonIds.join(',') : undefined}>
  <span class:list={['track-cover', { 'track-cover-empty': !cover }]}>
    {cover ? <img src={cover.src} alt={cover.alt} width="1200" height="750" loading="lazy" decoding="async" /> : null}
    <span class="track-badge" aria-hidden="true">
      {icon ? <img src={icon} alt="" width="96" height="96" loading="lazy" decoding="async" /> : <img src="/images/marble/marble-sphere-plinth.webp" alt="" width="96" height="96" loading="lazy" decoding="async" />}
    </span>
  </span>
  <span class="track-card-body">
    <span class="course-kicker">{category}{open && lessonIds.length ? ` · ${lessonIds.length} lessons` : ''}{!open && planned.length ? ` · ${planned.length} lessons` : ''}{open ? '' : ' · Coming soon'}</span>
    <span class="track-title">{track.data.title}</span>
    <span class="track-desc">{track.data.description}</span>
    {open && lessonIds.length > 0 ? (
      <span class="track-meter">
        <span class="track-meter-bar" data-track-bar style="width: 0%" />
        <span class="track-meter-label" data-track-count>
          0 of {lessonIds.length} done on this device
        </span>
      </span>
    ) : null}
    {planned.length > 0 ? (
      <ol class="track-planned">
        {planned.map((lesson) => <li>{lesson.title}</li>)}
      </ol>
    ) : null}
  </span>
</a>

<style>
  .track-planned { margin: .5rem 0 0; padding-left: 1.25rem; list-style: decimal; font-size: .9rem; line-height: 1.5; opacity: .85; }
  .track-planned li { margin: .1rem 0; }
</style>

<script>
  function paintTrackProgress() {
    let done: string[] = [];
    try {
      const raw = localStorage.getItem('reset:lesson-progress');
      const parsed = raw ? (JSON.parse(raw) as { done?: unknown }) : {};
      done = Array.isArray(parsed.done) ? parsed.done.filter((id): id is string => typeof id === 'string') : [];
    } catch {
      done = [];
    }

    document.querySelectorAll<HTMLElement>('[data-track-card]').forEach((card) => {
      const ids = (card.dataset.lessonIds || '').split(',').filter(Boolean);
      if (!ids.length) return;
      const count = ids.filter((id) => done.includes(id)).length;
      const label = card.querySelector<HTMLElement>('[data-track-count]');
      const bar = card.querySelector<HTMLElement>('[data-track-bar]');
      if (label) label.textContent = `${count} of ${ids.length} done on this device`;
      if (bar) bar.style.width = `${Math.round((count / ids.length) * 100)}%`;
    });
  }

  function setupReveal() {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cards = document.querySelectorAll<HTMLElement>('.reveal');
    if (reduce || !('IntersectionObserver' in window)) {
      cards.forEach((card) => card.classList.add('is-in'));
      return;
    }
    const seen = new WeakSet<Element>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-in');
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.2 },
    );
    cards.forEach((card) => {
      if (seen.has(card)) return;
      seen.add(card);
      observer.observe(card);
    });
  }

  const boot = () => {
    paintTrackProgress();
    setupReveal();
  };
  boot();
  document.addEventListener('astro:page-load', boot);
</script>
