---
import { sponsorUrl, sponsors, type SponsorPlacement } from '@utils/sponsors';
import { themeConfig } from '~/theme.config';

interface Props {
  placement: SponsorPlacement;
  class?: string;
  label?: string;
}

const { placement, class: className = '', label = 'Sponsor' } = Astro.props;
const priceLabel = `$${themeConfig.advertise?.priceMonthly ?? 50}`;
---

<div class:list={['sponsor-slot', className]} data-sponsor-slot={placement}>
  <p class="sponsor-kicker">{label}</p>
  {
    sponsors.map((sponsor, index) => {
      const href = sponsorUrl(sponsor.url, placement);
      const external = href.startsWith('http');
      return (
        <a
          class="sponsor-card"
          data-sponsor-card
          data-sponsor-id={sponsor.id}
          href={href}
          hidden={index !== 0}
          rel={external ? 'sponsored noopener' : 'sponsored'}
          target={external ? '_blank' : undefined}
        >
          <span class="sponsor-name">{sponsor.name}</span>
          <span class="sponsor-tagline">{sponsor.tagline.replaceAll('{{price}}', priceLabel)}</span>
          <span class="sponsor-cta">{sponsor.cta}</span>
        </a>
      );
    })
  }
</div>
