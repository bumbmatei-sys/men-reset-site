---
import SponsorSlot from './SponsorSlot.astro';
import { sponsorsForPlacement } from '@utils/sponsors';
import { SPONSORS_ENABLED } from '@data/site';

const showStrip = SPONSORS_ENABLED && sponsorsForPlacement('mobile-strip').length > 0;
const showLeft = SPONSORS_ENABLED && sponsorsForPlacement('rail-left').length > 0;
const showRight = SPONSORS_ENABLED && sponsorsForPlacement('rail-right').length > 0;
---

{showStrip && (
  <div class="sponsor-mobile" data-sponsor-region="mobile-strip">
    <SponsorSlot placement="mobile-strip" label="Partner" />
  </div>
)}
{showLeft && (
  <aside class="sponsor-rail sponsor-rail-left" aria-label="Partners">
    <SponsorSlot placement="rail-left" label="Partner" />
  </aside>
)}
{showRight && (
  <aside class="sponsor-rail sponsor-rail-right" aria-label="Partners">
    <SponsorSlot placement="rail-right" label="Partner" />
  </aside>
)}
