---
import SponsorSlot from './SponsorSlot.astro';
import { sponsorsForPlacement } from '@utils/sponsors';

const showStrip = sponsorsForPlacement('mobile-strip').length > 0;
const showRail = sponsorsForPlacement('rail-left').length > 0;
---

{showStrip && (
  <div class="sponsor-mobile" data-sponsor-region="mobile-strip">
    <SponsorSlot placement="mobile-strip" label="Sponsor" />
  </div>
)}
{showRail && (
  <aside class="sponsor-rail sponsor-rail-left" aria-label="Sponsors">
    <SponsorSlot placement="rail-left" label="Sponsor" />
  </aside>
)}
{showRail && (
  <aside class="sponsor-rail sponsor-rail-right" aria-label="Sponsors">
    <SponsorSlot placement="rail-right" label="Sponsor" />
  </aside>
)}
