---
/** Language picker. Hrefs and the current label are set on the client from the URL,
 *  so the post-build translator (scripts/i18n) leaves this block alone (data-no-translate). */
interface Props { variant?: 'header' | 'menu' }
const { variant = 'header' } = Astro.props;
const langs = [['en', 'English', 'us'], ['de', 'Deutsch', 'de']];
const flag = (f: string) => `/flags/${f}.svg`;
const check = '<svg class="lang-check" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M5 10.5l3.2 3L15 6.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
{variant === 'header' ? (
  <details class="lang-switch" data-lang-switch data-no-translate translate="no">
    <summary class="lang-switch-trigger" aria-label="Language">
      <img class="lang-flag" data-lang-flag src="/flags/us.svg" alt="" width="20" height="14" />
      <span data-lang-current>EN</span>
      <svg class="lang-chevron" viewBox="0 0 20 20" width="14" height="14" aria-hidden="true"><path d="M5.5 7.5L10 12l4.5-4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </summary>
    <ul class="lang-switch-menu" role="list">
      {langs.map(([code, name, f]) => <li><a data-astro-reload data-lang={code} data-flag={f} hreflang={code} lang={code} href={code === 'en' ? '/' : `/${code}`}><img class="lang-flag" src={flag(f)} alt="" width="20" height="14" loading="lazy" /><span class="lang-name">{name}</span><Fragment set:html={check} /></a></li>)}
    </ul>
  </details>
) : (
  <ul class="lang-switch-list" data-no-translate translate="no">
    {langs.map(([code, name, f]) => <li><a data-astro-reload data-lang={code} data-flag={f} hreflang={code} lang={code} href={code === 'en' ? '/' : `/${code}`}><img class="lang-flag" src={flag(f)} alt="" width="20" height="14" loading="lazy" /><span class="lang-name">{name}</span><Fragment set:html={check} /></a></li>)}
  </ul>
)}

<script>
  const LOCALES = ['de'];
  // The build writes a list of German routes that passed full-content translation.
  const publishedGerman = fetch('/i18n-pages-de.json')
    .then((response) => response.ok ? response.json() as Promise<string[]> : [])
    .catch(() => [] as string[]);
  function setupLang() {
    const parts = location.pathname.split('/');
    const current = LOCALES.includes(parts[1]) ? parts[1] : 'en';
    const rest = current === 'en' ? location.pathname : '/' + parts.slice(2).join('/');
    const base = rest === '/' ? '' : rest.replace(/\/$/, '');
    document.querySelectorAll<HTMLElement>('[data-lang-current]').forEach((el) => (el.textContent = current.toUpperCase()));
    const flags: Record<string, string> = { en: 'us', nb: 'no' };
    document.querySelectorAll<HTMLImageElement>('[data-lang-flag]').forEach((img) => (img.src = `/flags/${flags[current] ?? current}.svg`));
    document.querySelectorAll<HTMLDetailsElement>('[data-lang-switch]').forEach((d) => {
      if (d.dataset.bound) return;
      d.dataset.bound = '1';
      d.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && d.open) { d.open = false; d.querySelector('summary')?.focus(); }
        if ((e.key === 'ArrowDown' || e.key === 'ArrowUp') && d.open) {
          const items = [...d.querySelectorAll<HTMLAnchorElement>('a[data-lang]')];
          const i = items.indexOf(document.activeElement as HTMLAnchorElement);
          const next = e.key === 'ArrowDown' ? (i + 1) % items.length : (i - 1 + items.length) % items.length;
          items[i < 0 ? 0 : next].focus(); e.preventDefault();
        }
      });
      document.addEventListener('click', (e) => { if (d.open && !d.contains(e.target as Node)) d.open = false; });
    });
    document.querySelectorAll<HTMLAnchorElement>('a[data-lang]').forEach((a) => {
      const code = a.dataset.lang!;
      const currentPath = base || '/';
      if (code === 'en') {
        a.href = currentPath + location.search;
      } else {
        // Start with a safe destination until the translation manifest loads.
        a.href = '/de';
        void publishedGerman.then((paths) => {
          if (!a.isConnected) return;
          const fallback = currentPath.startsWith('/teachings/') ? '/teachings'
            : currentPath.startsWith('/tracks/') ? '/tracks' : '/';
          const target = paths.includes(currentPath) ? currentPath : paths.includes(fallback) ? fallback : '/';
          a.href = (target === '/' ? '/de' : `/de${target}`) + location.search;
        });
      }
      a.setAttribute('aria-current', code === current ? 'true' : 'false');
      if (a.dataset.bound) return;
      a.dataset.bound = '1';
      a.addEventListener('click', () => {
        document.cookie = `lang=${code}; path=/; max-age=31536000; samesite=lax`;
      });
    });
  }
  setupLang();
  document.addEventListener('astro:page-load', setupLang);
</script>

<style is:global>
  .lang-switch { position: relative; }
  .lang-switch-trigger { display: inline-flex; align-items: center; gap: 0.4rem; height: 2.25rem; padding: 0 0.7rem; border: 1px solid rgba(0, 0, 0, 0.14); border-radius: 999px; cursor: pointer; list-style: none; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.02em; transition: background-color 0.15s ease, border-color 0.15s ease; user-select: none; }
  .lang-switch-trigger::-webkit-details-marker { display: none; }
  .lang-switch-trigger:hover { background: rgba(0, 0, 0, 0.05); }
  .lang-switch-trigger:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  .lang-chevron { opacity: 0.6; transition: transform 0.15s ease; }
  .lang-switch[open] .lang-chevron { transform: rotate(180deg); }
  :where(.dark) .lang-switch-trigger { border-color: rgba(255, 255, 255, 0.2); }
  :where(.dark) .lang-switch-trigger:hover { background: rgba(255, 255, 255, 0.08); }
  .lang-flag { display: inline-block; flex: none; width: 20px; height: 14px; object-fit: cover; border-radius: 3px; box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.12); }
  :where(.dark) .lang-flag { box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.18); }
  .lang-switch-menu { position: absolute; right: 0; top: calc(100% + 0.5rem); z-index: 60; width: 13rem; margin: 0; padding: 0.4rem; list-style: none; border-radius: 1rem; border: 1px solid rgba(0, 0, 0, 0.08); background: #fff; box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12), 0 2px 6px rgba(0, 0, 0, 0.06); animation: lang-pop 0.14s ease-out; }
  @keyframes lang-pop { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  :where(.dark) .lang-switch-menu { background: #1c1c1c; border-color: rgba(255, 255, 255, 0.12); box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5); }
  .lang-switch-menu a, .lang-switch-list a { display: flex; align-items: center; gap: 0.65rem; padding: 0.55rem 0.7rem; border-radius: 0.65rem; text-decoration: none; color: inherit; font-size: 0.92rem; font-weight: 500; }
  .lang-switch-menu a:hover, .lang-switch-menu a:focus-visible { background: rgba(0, 0, 0, 0.05); outline: none; }
  :where(.dark) .lang-switch-menu a:hover, :where(.dark) .lang-switch-menu a:focus-visible { background: rgba(255, 255, 255, 0.08); }
  .lang-switch-menu li, .lang-switch-list li { margin: 0; padding: 0; list-style: none; }
  .lang-switch-menu li::before, .lang-switch-list li::before { content: none; }
  .lang-name { flex: 1; }
  .lang-check { visibility: hidden; flex: none; }
  a[aria-current='true'] .lang-check { visibility: visible; }
  a[aria-current='true'] { font-weight: 700; }
  .lang-switch-list { display: grid; grid-template-columns: 1fr 1fr; gap: 0.35rem; width: 100%; margin: 1.75rem 0 0; padding: 1.25rem 0 0; list-style: none; border-top: 1px solid rgba(127, 127, 127, 0.25); }
  .lang-switch-list a { border: 1px solid rgba(0, 0, 0, 0.1); font-size: 0.95rem; }
  :where(.dark) .lang-switch-list a { border-color: rgba(255, 255, 255, 0.15); }
  .lang-switch-list a[aria-current='true'] { border-color: currentColor; }
</style>
